{
  "name": "solrepr",
  "displayName": "SolRepr",
  "description": "Semantic analyzer and language server for Solidity",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Honour-d-dev/SolRepr.git"
  },
  "homepage": "https://github.com/Honour-d-dev/SolRepr#readme",
  "bugs": {
    "url": "https://github.com/Honour-d-dev/SolRepr/issues"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "evm",
    "lsp",
    "language-server"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.sol"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "solidity",
        "aliases": [
          "Solidity",
          "solidity"
        ],
        "extensions": [
          ".sol"
        ]
      }
    ],
    "commands": [
      {
        "command": "solrepr.viewHir",
        "title": "View HIR (Lowered)",
        "category": "SolRepr"
      },
      {
        "command": "solrepr.viewAst",
        "title": "View AST (Named Tree)",
        "category": "SolRepr"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "solrepr.viewHir",
          "when": "editorLangId == solidity"
        },
        {
          "command": "solrepr.viewAst",
          "when": "editorLangId == solidity"
        }
      ]
    },
    "configuration": {
      "title": "SolRepr",
      "properties": {
        "solrepr.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the solrepr server binary. If empty, the bundled binary, PATH, or a development build is used."
        },
        "solrepr.trace.server": {
          "type": "string",
          "default": "verbose",
          "description": "Trace level for the LSP server."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./",
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=out/extension.js",
    "watch": "npm run compile -- --watch"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
