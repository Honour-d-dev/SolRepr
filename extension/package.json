{
  "name": "solrepr",
  "displayName": "SolRepr",
  "description": "Semantic analyzer and language server for Solidity",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:solidity",
    "workspaceContains:**/*.sol"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "solidity",
        "aliases": ["Solidity", "solidity"],
        "extensions": [".sol"]
      }
    ],
    "commands": [
      {
        "command": "solrepr.viewHir",
        "title": "View HIR (Lowered)",
        "category": "SolRepr"
      },
      {
        "command": "solrepr.viewAst",
        "title": "View AST (Named Tree)",
        "category": "SolRepr"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "solrepr.viewHir",
          "when": "editorLangId == solidity"
        },
        {
          "command": "solrepr.viewAst",
          "when": "editorLangId == solidity"
        }
      ]
    },
    "configuration": {
      "title": "SolRepr",
      "properties": {
        "solrepr.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the solrepr server binary. If empty, uses ../solrepr/target/debug/solrepr relative to the extension."
        },
        "solrepr.trace.server": {
          "type": "string",
          "default": "verbose",
          "description": "Trace level for the LSP server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
